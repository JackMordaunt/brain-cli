#!/usr/bin/env bash
# A transcript source the test suite owns, so the suite never reads anyone's
# real conversations. Same contract as a real adapter: --list and --emit.
set -uo pipefail
ROOT="${FIXTURE_TRANSCRIPTS:?FIXTURE_TRANSCRIPTS must point at the fixture directory}"
case "${1:-}" in
  --list) find "$ROOT" -name '*.tsv' -type f 2>/dev/null ;;
  --emit) cat "${2:?}" ;;
  *)      echo "usage: fixture --list | --emit <path>" >&2; exit 2 ;;
esac
