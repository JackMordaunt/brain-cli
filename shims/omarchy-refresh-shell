#!/usr/bin/env bash
# A PATH shim, not a shell function: `bash -c` never sources ~/.bashrc, so a
# function guards only interactive shells. A shim on PATH covers every shell,
# every script and every exec by name.
#
# Add another guard by symlinking this file under the guarded command's name
# and giving it a case below.
set -uo pipefail

self=$(basename -- "$0")
# readlink -f is GNU-only; resolve the symlink chain by hand so the shim works
# on macOS and in Git Bash too.
resolve_dir() {
  local p="$1" d
  while [ -L "$p" ]; do
    d=$(cd -- "$(dirname -- "$p")" && pwd -P)
    p=$(readlink -- "$p")
    case "$p" in /*) ;; *) p="$d/$p" ;; esac
  done
  (cd -- "$(dirname -- "$p")" && pwd -P)
}
shim_dir=$(resolve_dir "$0")

real_path() {
  local p
  p=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vxF "$shim_dir" | tr '\n' ':')
  p=${p%:}
  PATH="$p" command -v -- "$self"
}

if [ "${BRAIN_GUARD_OVERRIDE:-}" = "1" ]; then
  real=$(real_path) || { printf '%s: nothing to run outside the shim\n' "$self" >&2; exit 127; }
  exec "$real" "$@"
fi

case "$self" in
  omarchy-refresh-shell)
    reason="it resets your shell settings and you restore them by hand"
    instead="omarchy-restart-shell"
    source_note='AI/LEARNINGS.md, "omarchy shell reload", 2026-09-23'
    ;;
  *)
    reason="the Brain has it recorded as a trap"
    instead=""
    source_note="AI/LEARNINGS.md"
    ;;
esac

{
  printf 'refused: %s — %s.\n\n' "$self" "$reason"
  [ -n "$instead" ] && printf '  use instead:      %s\n' "$instead"
  printf '  really meant it:  BRAIN_GUARD_OVERRIDE=1 %s\n\n' "$self"
  printf '(%s)\n' "$source_note"
} >&2
exit 1
