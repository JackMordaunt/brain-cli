#!/usr/bin/env bash
# brain — query and lint the Brain vault.
#
# Markdown under the vault is canonical. The SQLite database is a disposable
# index rebuilt from it; delete it at any time and `brain sync` restores it.
#
# Two roots, and they are not the same thing:
#
#   TOOL   this repository — the CLI, its hooks, shims and synonyms. Public,
#          distributable, carries no notes.
#   VAULT  the markdown someone keeps. Private, theirs, committed separately.
#
# A checkout that holds both still works: if the directory above bin/ has an
# AI/ in it, that is the vault too. That is how this started, and splitting the
# repositories must not strand an existing clone.
set -uo pipefail

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/brain"
CONF_VAULT="$CONF_DIR/vault"
STATE="${BRAIN_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/brain}"
DB="$STATE/brain.db"
RECALL_DB="$STATE/transcripts.db"
CONF_SOURCES="$CONF_DIR/sources"
RECALL_LIMIT=10
CORE="AI/MEMORY.md AI/LEARNINGS.md AI/TUNINGS.md"
MAXLEN=400          # soft cap on a bullet's fact text
STALE_DAYS=90       # a fact older than this wants re-verification
FIND_LIMIT=8
FIND_BYTES=4000
PROMOTE_QUERIES=3   # a bullet returned this often is a candidate for a gate
SCHEMA=2            # bump when a table changes shape; ensure_db then rebuilds

die() { printf 'brain: %s\n' "$*" >&2; exit 1; }

# Git Bash started from PowerShell or cmd inherits the Windows PATH, where
# C:\Windows\system32\find.exe and sort.exe shadow the POSIX tools called here.
# A native sqlite3.exe also writes CRLF: `read` keeps the \r, and every value
# read back then fails to match the one stored (a zero-hit query re-run by
# `brain log` was never set aside, observed 2026-09-25).
case "${OSTYPE:-}" in
  msys*|cygwin*)
    PATH="/usr/bin:$PATH"
    sqlite3() { command sqlite3 "$@" | tr -d '\r'; }
    ;;
esac

# A path inside SQL text is not an argument, so MSYS never translates it for a
# native sqlite3.exe, which then opens \c\Users\... and finds nothing.
sql_path() {
  if command -v cygpath >/dev/null 2>&1; then cygpath -m -- "$1"; else printf '%s\n' "$1"; fi
}

os_kind() {
  case "$(uname -s 2>/dev/null)" in
    Linux*)                 echo linux ;;
    Darwin*)                echo macos ;;
    MINGW*|MSYS*|CYGWIN*)   echo windows ;;
    *)                      echo unknown ;;
  esac
}

# readlink -f is GNU-only, so walk the symlink chain by hand.
resolve_dir() {
  local p="$1" d
  while [ -L "$p" ]; do
    d=$(cd -- "$(dirname -- "$p")" && pwd -P)
    p=$(readlink -- "$p")
    case "$p" in /*) ;; *) p="$d/$p" ;; esac
  done
  (cd -- "$(dirname -- "$p")" && pwd -P)
}

# The tool is wherever this script is: bin/brain, so one directory up. That is
# always knowable, needs no config, and is what a clone runs from.
TOOL=$(resolve_dir "$0"); TOOL=${TOOL%/bin}

# Where the vault is, in order of authority:
#   $BRAIN_VAULT        an explicit override, for a second clone or a test
#   the script's own location, when that checkout holds notes too — the
#                       combined layout this repository used to have, kept so
#                       an existing clone keeps working after the split
#   ~/.config/brain/vault   written by `brain install`; the normal answer once
#                       tool and vault are separate repositories, and the only
#                       one on Windows, where install copies the script and its
#                       location says nothing about where the vault is
find_vault() {
  local d
  if [ -n "${BRAIN_VAULT:-}" ]; then printf '%s\n' "$BRAIN_VAULT"; return 0; fi
  [ -d "$TOOL/AI" ] && { printf '%s\n' "$TOOL"; return 0; }
  if [ -r "$CONF_VAULT" ]; then
    d=$(head -1 "$CONF_VAULT")
    [ -n "$d" ] && [ -d "$d" ] && { printf '%s\n' "$d"; return 0; }
  fi
  return 1
}
VAULT=$(find_vault) || VAULT=""
need_vault() {
  [ -n "$VAULT" ] || die "no vault yet: run 'brain install <path-to-vault>', or set BRAIN_VAULT"
  [ -d "$VAULT" ] || die "vault recorded but missing: $VAULT"
}

# GNU find's -printf and bash 4's mapfile are unavailable on macOS, so list
# files the portable way and build the array with a read loop.
list_md() { find . -name '*.md' ! -path './.git/*' -print | sed 's|^\./||' | LC_ALL=C sort; }

require_sqlite() {
  # type -P, not command -v: the Windows wrapper above is a function by that name.
  type -P sqlite3 >/dev/null 2>&1 || die "sqlite3 is not installed (brew install sqlite / pacman -S sqlite / winget install SQLite.SQLite)"
  sqlite3 :memory: "create virtual table t using fts5(a);" >/dev/null 2>&1 \
    || die "this sqlite3 lacks FTS5; install a build with it enabled"
}

# The index is disposable and rebuilt on demand, so no agent needs to know
# that 'brain sync' exists: a missing or stale database resyncs itself.
ensure_db() {
  need_vault
  if [ ! -s "$DB" ]; then cmd_sync >/dev/null; return 0; fi
  # An index built by an older CLI rebuilds itself; the logs carry over.
  if [ "$(sqlite3 "$DB" 'pragma user_version' 2>/dev/null)" != "$SCHEMA" ]; then cmd_sync >/dev/null; return 0; fi
  local newer
  newer=$(find "$VAULT" -name '*.md' ! -path '*/.git/*' -newer "$DB" -print -quit 2>/dev/null)
  [ -n "$newer" ] && cmd_sync >/dev/null
  return 0
}

# ---------------------------------------------------------------- parse ----
# Emits SQL INSERTs for every bullet in the files named on stdin.
# Shape: - **handle** (aliases) — fact — source — YYYY-MM-DD
# A line that does not parse is skipped, never fatal: markdown stays
# authoritative and the index stays advisory.
emit_sql() {
  awk '
    function esc(s) { gsub(/'"'"'/, "'"'"''"'"'", s); return s }
    { sub(/\r$/, "") }
    FNR==1 { section="" }
    /^## / { section=substr($0,4); next }
    /^- \*\*/ {
      raw=$0
      n=split(raw, f, / — /)
      hdr=f[1]
      date=""; src=""; fact=""
      if (n >= 2 && f[n] ~ /^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) {
        date=f[n]
        if (n >= 3) src=f[n-1]
        for (i=2; i<=n-2; i++) fact = fact (fact==""?"":" — ") f[i]
        if (n == 2) fact=""
      } else {
        for (i=2; i<=n; i++) fact = fact (fact==""?"":" — ") f[i]
      }
      handle=""; aliases=""
      if (match(hdr, /\*\*[^*]+\*\*/)) handle=substr(hdr, RSTART+2, RLENGTH-4)
      if (match(hdr, /\([^)]*\)/)) {
        aliases=substr(hdr, RSTART+1, RLENGTH-2)
        sub(/^aliases: */, "", aliases)
      }
      if (handle == "" || date == "") next
      printf "insert into bullets(file,line,section,handle,aliases,fact,source,date,raw,len) values(%s,%d,%s,%s,%s,%s,%s,%s,%s,%d);\n",
        "'"'"'" esc(FILENAME) "'"'"'", FNR, "'"'"'" esc(section) "'"'"'",
        "'"'"'" esc(handle) "'"'"'", "'"'"'" esc(aliases) "'"'"'",
        "'"'"'" esc(fact) "'"'"'", "'"'"'" esc(src) "'"'"'",
        "'"'"'" esc(date) "'"'"'", "'"'"'" esc(raw) "'"'"'", length(fact)
    }
  ' "$@"
}

emit_links() {
  awk '
    function esc(s) { gsub(/'"'"'/, "'"'"''"'"'", s); return s }
    { sub(/\r$/, "") }
    {
      s=$0
      while (match(s, /\[\[[^]]+\]\]/)) {
        t=substr(s, RSTART+2, RLENGTH-4)
        sub(/\|.*$/, "", t)
        printf "insert into links(file,line,target) values(%s,%d,%s);\n",
          "'"'"'" esc(FILENAME) "'"'"'", FNR, "'"'"'" esc(t) "'"'"'"
        s=substr(s, RSTART+RLENGTH)
      }
    }
  ' "$@"
}

# Prose lines, so artifacts and handoffs are findable too. Bullets are
# excluded: they are indexed with structure in the bullets table.
emit_lines() {
  awk '
    function esc(s) { gsub(/'"'"'/, "'"'"''"'"'", s); return s }
    { sub(/\r$/, "") }
    length($0) > 20 && $0 !~ /^- \*\*/ {
      printf "insert into lines(file,line,text) values(%s,%d,%s);\n",
        "'"'"'" esc(FILENAME) "'"'"'", FNR, "'"'"'" esc($0) "'"'"'"
    }
  ' "$@"
}

# ----------------------------------------------------------------- sync ----
cmd_sync() {
  need_vault
  require_sqlite
  mkdir -p "$STATE"
  cd "$VAULT" || die "no vault at $VAULT"
  local tmp="$DB.new"
  rm -f "$tmp"
  local files _f
  files=()
  while IFS= read -r _f; do files+=("$_f"); done < <(list_md)
  [ "${#files[@]}" -gt 0 ] || die "no markdown found under $VAULT"

  {
    cat <<'SQL'
create table bullets(
  id integer primary key, file text, line integer, section text,
  handle text, aliases text, fact text, source text, date text,
  raw text, len integer);
create table links(file text, line integer, target text);
create table docs(file text primary key, title text);
create virtual table bullets_fts using fts5(handle, aliases, fact);
create table lines(id integer primary key, file text, line integer, text text);
create virtual table lines_fts using fts5(text);
create table synonyms(term text, expansion text);
SQL
    echo "begin;"
    emit_sql "${files[@]}"
    emit_links "${files[@]}"
    emit_lines "${files[@]}"
    for f in "${files[@]}"; do
      printf "insert into docs(file,title) values('%s','%s');\n" \
        "${f//\'/\'\'}" "$(head -20 "$f" | grep -m1 '^# ' | sed "s/^# //; s/'/''/g")"
    done
    echo "insert into bullets_fts(rowid,handle,aliases,fact) select id,handle,aliases,fact from bullets;"
    echo "insert into lines_fts(rowid,text) select id,text from lines;"
    echo "commit;"
  } | sqlite3 "$tmp" || { rm -f "$tmp"; die "index build failed"; }

  # Synonyms ship with the tool, so the vocabulary travels with the CLI rather
  # than with one person's notes. A vault may add its own on top.
  if [ -f "$TOOL/bin/synonyms.tsv" ]; then
    awk -F'\t' 'NR>1 && NF>=2 { gsub(/'"'"'/, "'"'"''"'"'", $1); gsub(/'"'"'/, "'"'"''"'"'", $2);
      printf "insert into synonyms(term,expansion) values('"'"'%s'"'"','"'"'%s'"'"');\n", $1, $2 }' \
      "$TOOL/bin/synonyms.tsv" | sqlite3 "$tmp"
  fi

  # The logs survive a rebuild: they are evidence, not derived data. Bullet row
  # ids are reassigned on every sync, so a returned bullet is recorded by handle.
  sqlite3 "$tmp" "create table queries(id integer primary key, ts text, q text, hits integer,
      caller text, session text);
    create table query_hits(query_id integer, file text, handle text, rank integer);"
  if [ -s "$DB" ]; then
    local old; old=$(sql_path "$DB")
    # A log written before the caller columns existed carries over with them empty.
    if sqlite3 "$DB" "select caller, session from queries limit 0" >/dev/null 2>&1; then
      sqlite3 "$tmp" "attach '$old' as old; insert into queries(id,ts,q,hits,caller,session)
        select rowid,ts,q,hits,caller,session from old.queries;" 2>/dev/null
    else
      sqlite3 "$tmp" "attach '$old' as old; insert into queries(id,ts,q,hits,caller,session)
        select rowid,ts,q,hits,'','' from old.queries;" 2>/dev/null
    fi
    sqlite3 "$tmp" "attach '$old' as old; insert into query_hits select * from old.query_hits;" 2>/dev/null
  fi

  sqlite3 "$tmp" "pragma user_version=$SCHEMA;"
  mv -f "$tmp" "$DB"
  rm -f "$DB.new-wal" "$DB.new-shm"
  printf 'indexed %s bullets, %s links, %s files\n' \
    "$(sqlite3 "$DB" 'select count(*) from bullets')" \
    "$(sqlite3 "$DB" 'select count(*) from links')" \
    "${#files[@]}"
}

# ----------------------------------------------------------------- find ----
# Handle matches outrank body matches, so a bullet named **review** beats a
# handoff that merely mentions the word.
# Turns a raw query into the two FTS5 match strings `find` tries in order:
# every term (with its synonyms) required, then any term. Sets M_AND and M_OR;
# returns 1 when nothing survives tokenising.
build_match() {
  local raw="$1" groups=() t syns esc grp s i
  for t in $(printf '%s' "$raw" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9.\-_ ' ' '); do
    [ -n "$t" ] || continue
    esc="\"${t//\"/}\""
    grp="$esc"
    syns=$(sqlite3 "$DB" "select expansion from synonyms where term='${t//\'/\'\'}'" 2>/dev/null)
    while IFS= read -r s; do
      [ -n "$s" ] && grp="$grp OR \"${s//\"/}\""
    done <<< "$syns"
    groups+=("($grp)")
  done
  [ "${#groups[@]}" -gt 0 ] || return 1
  M_AND="${groups[0]}"; for ((i=1;i<${#groups[@]};i++)); do M_AND="$M_AND AND ${groups[i]}"; done
  M_OR="${groups[0]}";  for ((i=1;i<${#groups[@]};i++)); do M_OR="$M_OR OR ${groups[i]}"; done
}

# A bullet result is three lines (locator, bullet, blank); a document result is
# one. Counting entries rather than lines keeps the log honest: the earlier
# line count reported 28 for a capped query that returned 8 bullets.
count_entries() { grep -c '^[^[:space:]]*\.md:[0-9][0-9]*$' <<< "$1"; }

# Who asked. Agents set BRAIN_CALLER/BRAIN_SESSION; Claude Code is recognised
# from its own environment; anything else is a human at a shell, named after
# the parent process where ps can say.
caller_id() {
  if [ -n "${BRAIN_CALLER:-}" ]; then printf '%s' "$BRAIN_CALLER"
  elif [ -n "${CLAUDECODE:-}" ]; then printf 'claude'
  else printf '%s' "$(ps -o comm= -p $PPID 2>/dev/null | tr -d ' ' || true)"; fi
}
session_id() { printf '%s' "${BRAIN_SESSION:-${CLAUDE_CODE_SESSION_ID:-}}"; }

cmd_find() {
  ensure_db
  [ $# -gt 0 ] || die "usage: brain find <terms...>"
  local raw="$*" M_AND M_OR
  build_match "$raw" || die "empty query"

  local used hits out docs
  out=$(query_fts "$M_AND"); used="$M_AND"
  [ -z "$out" ] && { out=$(query_fts "$M_OR"); used="$M_OR"; }
  docs=$(query_lines "$M_AND")
  [ -z "$docs" ] && docs=$(query_lines "$M_OR")

  hits=0
  [ -n "$out" ]  && hits=$(count_entries "$out")
  [ -n "$docs" ] && hits=$((hits + $(grep -c '^' <<< "$docs")))

  local qid caller session
  caller=$(caller_id); session=$(session_id)
  qid=$(sqlite3 "$DB" "insert into queries(ts,q,hits,caller,session)
    values(datetime('now'),'${raw//\'/\'\'}',$hits,'${caller//\'/\'\'}','${session//\'/\'\'}');
    select last_insert_rowid();" 2>/dev/null)
  # Which bullets answered, so a bullet no query ever returns becomes visible.
  if [ -n "$out" ] && [ -n "${qid:-}" ]; then
    sqlite3 "$DB" "insert into query_hits(query_id,file,handle,rank)
      select $qid, b.file, b.handle,
        row_number() over (order by bm25(bullets_fts, 10.0, 6.0, 1.0))
      from bullets_fts f join bullets b on b.id = f.rowid
      where bullets_fts match '${used//\'/\'\'}'
      order by bm25(bullets_fts, 10.0, 6.0, 1.0) limit $FIND_LIMIT;" 2>/dev/null
  fi

  if [ "$hits" -eq 0 ]; then
    echo "no hits for: $raw"
    echo "(logged — 'brain log' lists zero-hit queries as the synonym backlog)"
    return 1
  fi
  if [ -n "$out" ]; then
    awk -v max="$FIND_BYTES" '
      { n += length($0)+1; if (n > max) { print "… output capped; narrow the query"; exit } print }
    ' <<< "$out"
  fi
  if [ -n "$docs" ]; then
    echo "-- documents --"
    cut -c1-220 <<< "$docs"
  fi
}

query_fts() {
  sqlite3 -separator '' "$DB" "
    select b.file || ':' || b.line || char(10) || b.raw || char(10)
    from bullets_fts f join bullets b on b.id = f.rowid
    where bullets_fts match '${1//\'/\'\'}'
    order by bm25(bullets_fts, 10.0, 6.0, 1.0)
    limit $FIND_LIMIT;" 2>/dev/null
}

query_lines() {
  sqlite3 -separator '  ' "$DB" "
    select l.file || ':' || l.line, substr(l.text,1,200)
    from lines_fts f join lines l on l.id = f.rowid
    where lines_fts match '${1//\'/\'\'}'
      and l.file not in ($(csv_core))
    order by bm25(lines_fts) limit 5;" 2>/dev/null
}

# The bootstrap answer: an agent that has `brain` on PATH can always find the
# vault, without already knowing where it is.
cmd_locate() {
  local p
  if [ "${1:-}" = "--tool" ]; then p="$TOOL"; shift; else need_vault; p="$VAULT"; fi
  # brain.cmd sets BRAIN_NATIVE, so PowerShell and cmd get a path they can cd to.
  if { [ "${1:-}" = "--native" ] || [ -n "${BRAIN_NATIVE:-}" ]; } && command -v cygpath >/dev/null 2>&1; then
    cygpath -w -- "$p"
  else
    printf '%s\n' "$p"
  fi
}

# A miss is only a backlog item while it still misses. Most are a session
# asking about the thing it is in the middle of writing down — "agenda" missed
# at 17:42 and its bullet was committed at 18:15 — so every zero-hit query is
# re-run against the current index and the ones that now answer are set aside.
cmd_log() {
  ensure_db
  local q answered="" n=0 M_AND M_OR
  while IFS= read -r q; do
    [ -n "$q" ] || continue
    build_match "$q" || continue
    if [ -n "$(query_fts "$M_AND")$(query_fts "$M_OR")$(query_lines "$M_AND")$(query_lines "$M_OR")" ]; then
      answered="$answered${answered:+,}'${q//\'/\'\'}'"; n=$((n+1))
    fi
  done < <(sqlite3 "$DB" "select distinct q from queries where hits=0")

  echo "== zero-hit queries that still miss (the synonym backlog) =="
  sqlite3 -box "$DB" "select q as query, count(*) as misses, max(ts) as last
    from queries where hits=0 ${answered:+and q not in ($answered)}
    group by q order by misses desc, last desc limit 30;"
  [ "$n" -gt 0 ] && echo "($n missed then answered by a later edit: ${answered//\'/})"
  echo
  echo "== recent queries =="
  sqlite3 -box "$DB" "select ts, q as query, hits, caller from queries order by ts desc limit 15;"
  echo
  echo "== who asks: queries and distinct sessions per caller =="
  sqlite3 -box "$DB" "select coalesce(nullif(caller,''),'?') as caller, count(*) as queries,
    count(distinct nullif(session,'')) as sessions, sum(hits=0) as misses
    from queries group by 1 order by 2 desc;"
}

# --------------------------------------------------------------- doctor ----
cmd_doctor() {
  ensure_db
  local q
  echo "== stale: not verified in ${STALE_DAYS}d =="
  sqlite3 -box "$DB" "select date, file, handle from bullets
    where date <> '' and date < date('now','-${STALE_DAYS} day')
    order by date limit 40;"

  echo; echo "== thin aliases (<2) — a future searcher's vocabulary is missing =="
  sqlite3 -box "$DB" "select file, handle, aliases from bullets
    where file in ($(csv_core)) and
      (aliases='' or (length(aliases)-length(replace(aliases,',',''))) < 1)
    order by file, handle;"

  echo; echo "== oversized bullets (fact > ${MAXLEN} chars) =="
  sqlite3 -box "$DB" "select file, handle, len from bullets
    where len > $MAXLEN order by len desc;"

  echo; echo "== duplicate handles =="
  sqlite3 -box "$DB" "select handle, count(*) n, group_concat(file,' + ') files
    from bullets group by lower(handle) having n > 1;"

  echo; echo "== dead wikilinks =="
  sqlite3 -box "$DB" "select l.file, l.line, l.target from links l
    where not exists (select 1 from docs d where d.file like '%' || l.target || '.md')
      and not exists (select 1 from bullets b where lower(b.handle)=lower(replace(l.target,'-',' ')))
    order by l.file limit 30;"

  echo; echo "== orphan artifacts (no bullet or document points at them) =="
  sqlite3 -box "$DB" "select d.file from docs d
    where d.file like 'AI/artifacts/%'
      and not exists (select 1 from bullets b where b.raw like '%' || replace(d.file,'AI/','') || '%')
      and not exists (select 1 from lines l where l.file <> d.file and l.text like '%' || replace(d.file,'AI/','') || '%')
    order by d.file;"

  # Frequency is the promote signal: a bullet that keeps answering queries is
  # being paid for in tokens on every hit, and a gate, shim or project file
  # would answer it for free. The earlier rule (handle named in 2+ handoffs)
  # never fired; this one reads the log that already exists.
  echo; echo "== promote candidates: returned by ${PROMOTE_QUERIES}+ queries — a gate or project file would answer for free =="
  sqlite3 -box "$DB" "select h.file, h.handle, count(distinct h.query_id) as queries,
      count(distinct nullif(q.session,'')) as sessions,
      substr(group_concat(distinct q.q), 1, 40) as asked_as
    from query_hits h join queries q on q.id = h.query_id
    where h.rank <= 3
    group by h.file, h.handle having queries >= $PROMOTE_QUERIES
    order by queries desc, sessions desc limit 20;"

  local nq
  nq=$(sqlite3 "$DB" 'select count(*) from queries' 2>/dev/null)
  echo; echo "== never returned by any query (prune candidates, from $nq queries) =="
  if [ "${nq:-0}" -lt 50 ]; then
    echo "   too few queries logged to mean anything yet — this needs months of real use"
  else
    sqlite3 -box "$DB" "select b.file, b.handle, b.date from bullets b
      where not exists (select 1 from query_hits h where h.handle = b.handle)
      order by b.date limit 30;"
  fi

  echo; echo "== zero-hit queries =="
  sqlite3 -box "$DB" "select q, count(*) n from queries where hits=0
    group by q order by n desc limit 15;"
}

csv_core() { local o="" f; for f in $CORE; do o="$o${o:+,}'$f'"; done; printf '%s' "$o"; }

# --------------------------------------------------------------- secrets ----
# ~/go/bin is not on a non-interactive PATH on this machine, and the hook runs
# non-interactively, so the scanner is resolved explicitly. A gate that
# silently fails to run is worse than no gate.
find_gitleaks() {
  local c
  for c in $HOME/go/bin/gitleaks /usr/bin/gitleaks /usr/local/bin/gitleaks /opt/homebrew/bin/gitleaks; do
    [ -x "$c" ] && { printf '%s\n' "$c"; return 0; }
  done
  command -v gitleaks 2>/dev/null && return 0
  return 1
}

# A floor for machines without gitleaks: only patterns that cannot plausibly be
# anything else. No 40-hex rule — that is a git SHA, and this vault is full of
# them.
fallback_patterns() {
  grep -nE \
    -e 'BEGIN [A-Z ]*PRIVATE KEY' \
    -e 'AKIA[0-9A-Z]{16}' \
    -e 'gh[pousr]_[A-Za-z0-9]{36,}' \
    -e 'xox[baprs]-[A-Za-z0-9-]{10,}' \
    -e 'eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}' \
    -e '[0-9a-f]{64,}'
}

# A vault may carry its own allowlist; otherwise the tool's default ruleset
# applies, so a fresh clone is still scanned.
gitleaks_config() {
  [ -f "$VAULT/.gitleaks.toml" ] && { printf '%s\n' "$VAULT/.gitleaks.toml"; return 0; }
  printf '%s\n' "$TOOL/.gitleaks.toml"
}

cmd_secrets() {
  need_vault
  local mode="${1:---staged}" gl rc=0 cfg
  gl=$(find_gitleaks) || gl=""
  cfg=$(gitleaks_config)

  if [ -n "$gl" ]; then
    case "$mode" in
      --history) "$gl" git "$VAULT" --no-banner --redact --config "$cfg" || rc=$? ;;
      *)         "$gl" git "$VAULT" --staged --no-banner --redact --config "$cfg" || rc=$? ;;
    esac
    [ "$rc" -eq 0 ] && echo "brain secrets: clean (gitleaks, $mode)"
    return "$rc"
  fi

  echo "brain secrets: gitleaks not found — falling back to six built-in patterns." >&2
  echo "  install it for the full ruleset: pacman -S gitleaks / brew install gitleaks / scoop install gitleaks" >&2
  local hits
  if [ "$mode" = "--history" ]; then
    hits=$(git -C "$VAULT" log -p --no-color | fallback_patterns || true)
  else
    hits=$(git -C "$VAULT" diff --cached -U0 --no-color | fallback_patterns || true)
  fi
  if [ -n "$hits" ]; then
    echo "brain secrets: possible secret in the change:" >&2
    printf '%s\n' "$hits" | head -20 >&2
    return 1
  fi
  echo "brain secrets: clean (built-in patterns, $mode)"
  return 0
}

# ----------------------------------------------------------------- lint ----
# Hard failures block a commit. Warnings never do. A line that does not parse
# is skipped rather than rejected, so the bullet format never becomes
# load-bearing.
cmd_lint() {
  need_vault
  local staged=0; [ "${1:-}" = "--staged" ] && { staged=1; shift; }
  local fails=0 warns=0
  local lines

  if [ "$staged" -eq 1 ]; then
    lines=$(git -C "$VAULT" diff --cached -U0 --src-prefix=a/ --dst-prefix=b/ -- '*.md' \
      | awk '{sub(/\r$/, "")} /^\+\+\+ b\//{f=substr($0,7)} /^\+[^+]/{printf "%s\037%s\n", f, substr($0,2)}')
  else
    local files=("$@"); [ "${#files[@]}" -eq 0 ] && files=($CORE)
    lines=$(cd "$VAULT" && awk '{sub(/\r$/, ""); printf "%s\037%s\n", FILENAME, $0}' "${files[@]}")
  fi

  while IFS=$'\037' read -r file text; do
    case " $CORE " in *" $file "*) ;; *) continue ;; esac
    case "$text" in '- **'*) ;; *) continue ;; esac
    local handle date fact
    handle=$(sed -n 's/^- \*\*\([^*]*\)\*\*.*/\1/p' <<< "$text")
    [ -n "$handle" ] || continue
    date=$(grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}$' <<< "$text" || true)
    fact=${text#*— }

    if [ -z "$date" ]; then
      printf 'FAIL %s: **%s** has no trailing ISO date\n' "$file" "$handle"; fails=$((fails+1))
    elif [[ "$date" > "$(date +%F)" ]]; then
      printf 'FAIL %s: **%s** is dated in the future (%s)\n' "$file" "$handle" "$date"; fails=$((fails+1))
    fi

    if grep -qiE '(password|secret|token|api[_-]?key)[[:space:]]*[:=][[:space:]]*[A-Za-z0-9/+_-]{16,}' <<< "$text" \
       && ! grep -qE '\$[A-Z_]{3,}|<[a-z]' <<< "$text"; then
      printf 'FAIL %s: **%s** looks like it carries a literal secret\n' "$file" "$handle"; fails=$((fails+1))
    fi
    if grep -q 'BEGIN [A-Z ]*PRIVATE KEY' <<< "$text"; then
      printf 'FAIL %s: **%s** contains a private key\n' "$file" "$handle"; fails=$((fails+1))
    fi

    if [ "${#fact}" -gt "$MAXLEN" ]; then
      printf 'warn %s: **%s** fact is %s chars (cap %s) — spill to an artifact and point at it\n' \
        "$file" "$handle" "${#fact}" "$MAXLEN"; warns=$((warns+1))
    fi
    if ! grep -q '(' <<< "${text%%— *}"; then
      printf 'warn %s: **%s** has no aliases — name the words a future searcher will type\n' \
        "$file" "$handle"; warns=$((warns+1))
    fi
  done <<< "$lines"

  if [ "$staged" -eq 1 ] && [ -s "$DB" ]; then
    local dupes
    dupes=$(sqlite3 "$DB" "select handle from bullets group by lower(handle) having count(*)>1;" 2>/dev/null)
    [ -n "$dupes" ] && while IFS= read -r h; do
      printf 'warn duplicate handle in the index: **%s**\n' "$h"; warns=$((warns+1))
    done <<< "$dupes"
  fi

  printf 'brain lint: %d failure(s), %d warning(s)\n' "$fails" "$warns"
  [ "$fails" -eq 0 ]
}

# ---------------------------------------------------------------- recall ----
# Transcripts are a second source, and deliberately not vault content: they are
# machine-written, never committed, and their formats belong to other people's
# programs. So they live in their own database, behind their own command, and
# the parsing lives in bin/adapters/<agent> — one script per agent, replaceable
# when that agent changes its format without touching anything here.
#
# What `brain find` answers is what was concluded and is still true. What
# `brain recall` answers is what was actually said, which is not the same thing
# and is not always right: a retracted claim reads exactly like a sound one.

ADAPTER_DIR="${BRAIN_ADAPTERS:-$TOOL/bin/adapters}"
adapters_all() { ls "$ADAPTER_DIR" 2>/dev/null; }

adapters_on() {
  [ -r "$CONF_SOURCES" ] || return 0
  local a
  while IFS= read -r a; do
    [ -n "$a" ] || continue
    case "$a" in \#*) continue ;; esac
    [ -x "$ADAPTER_DIR/$a" ] && printf '%s\n' "$a"
  done < "$CONF_SOURCES"
}

recall_schema() {
  sqlite3 "$RECALL_DB" <<'SQL'
create table if not exists source(path text primary key, adapter text);
create table if not exists turn(
  id text primary key, adapter text, session text, path text,
  ts text, role text, title text, cwd text, body text);
create virtual table if not exists turn_fts
  using fts5(body, title, content='turn', content_rowid='rowid');
create trigger if not exists turn_ai after insert on turn begin
  insert into turn_fts(rowid, body, title) values (new.rowid, new.body, new.title);
end;
create trigger if not exists turn_ad after delete on turn begin
  insert into turn_fts(turn_fts, rowid, body, title)
    values ('delete', old.rowid, old.body, old.title);
end;
SQL
}

# TSV in, SQL in. Turns are identified by the agent's own id, so a session
# resumed into a new file re-inserts nothing — and resuming is common: of 69207
# Claude Code message ids on this machine, 2606 appeared in more than one
# transcript (2026-09-25, counting duplicates in `jq -r .uuid` across
# ~/.claude/projects). Counting those twice would skew every ranking.
recall_rows_to_sql() {
  awk -F'\t' -v a="$1" '
    function esc(s) { gsub(/'"'"'/, "'"'"''"'"'", s); return s }
    NF >= 7 {
      body = $7
      for (i = 8; i <= NF; i++) body = body " " $i
      printf "insert or ignore into turn(id,adapter,session,path,ts,role,title,cwd,body) values('"'"'%s'"'"','"'"'%s'"'"','"'"'%s'"'"','"'"'%s'"'"','"'"'%s'"'"','"'"'%s'"'"','"'"'%s'"'"','"'"'%s'"'"','"'"'%s'"'"');\n",
        esc($1), esc(a), esc($4), esc(FILE), esc($2), esc($3), esc($5), esc($6), esc(body)
    }
  ' FILE="$2"
}

# The SQL for one transcript. Kept separate from the writing so a batch can
# concatenate many and open the database once.
recall_file_sql() {
  local adapter=$1 f=$2
  "$ADAPTER_DIR/$adapter" --emit "$f" | recall_rows_to_sql "$adapter" "$f"
  printf "insert or replace into source(path,adapter) values('%s','%s');\n" \
    "${f//\'/\'\'}" "$adapter"
}


# Everything an adapter can see, or only what moved since the last pass.
# Re-reading a whole transcript is cheap enough that there is no byte offset to
# keep and no partial trailing line to get wrong: on 2026-09-25 the largest
# transcript here (8.7 MB) parsed in 57ms and a live one in 14ms, so changed
# files are simply read again and the id primary key absorbs the overlap.
recall_sync() {
  local full=${1:-} a stamp changed n=0 total=0
  recall_schema
  for a in $(adapters_on); do
    stamp="$STATE/recall-$a.stamp"
    changed="$STATE/recall-$a.changed"
    if [ -n "$full" ] || [ ! -f "$stamp" ]; then
      "$ADAPTER_DIR/$a" --list > "$changed" 2>/dev/null || : > "$changed"
    else
      "$ADAPTER_DIR/$a" --list 2>/dev/null \
        | while IFS= read -r f; do [ "$f" -nt "$stamp" ] && printf '%s\n' "$f"; done > "$changed"
    fi
    # grep -c prints 0 and exits non-zero when nothing matches (POSIX: no lines
    # selected is status 1), so a `|| echo 0` appends a second zero and every
    # later arithmetic fails on the two-line value.
    n=$(grep -c '^' < "$changed" 2>/dev/null); n=${n:-0}
    total=$((total + n))
    if [ "$n" -gt 0 ]; then
      { printf 'pragma journal_mode=wal;\nbegin;\n'
        while IFS= read -r f; do recall_file_sql "$a" "$f"; done < "$changed"
        printf 'commit;\n'
      } | sqlite3 "$RECALL_DB" >/dev/null 2>&1 || true
    fi
    # A transcript that disappeared takes its turns with it.
    if [ -n "$full" ]; then
      "$ADAPTER_DIR/$a" --list 2>/dev/null | sort > "$changed.now"
      sqlite3 "$RECALL_DB" "select path from source where adapter='$a'" 2>/dev/null | sort > "$changed.was"
      comm -13 "$changed.now" "$changed.was" | while IFS= read -r gone; do
        [ -n "$gone" ] || continue
        sqlite3 "$RECALL_DB" "delete from turn where path='${gone//\'/\'\'}';
                              delete from source where path='${gone//\'/\'\'}';" 2>/dev/null
      done
      rm -f "$changed.now" "$changed.was"
    fi
    : > "$stamp"
    rm -f "$changed"
  done
  printf '%s\n' "$total"
}

recall_enabled_or_die() {
  local on; on=$(adapters_on)
  [ -n "$on" ] && return 0
  echo "brain recall: no transcript sources enabled." >&2
  echo >&2
  echo "  available: $(adapters_all | tr '\n' ' ')" >&2
  echo "  enable one: brain recall --enable claude" >&2
  return 1
}

cmd_recall() {
  local limit=$RECALL_LIMIT json=0 full="" sessions=0 prefix=0 terms=()
  local exclude="${CLAUDE_CODE_SESSION_ID:-${CLAUDE_SESSION_ID:-}}"
  # Its own transcript is on disk and will be picked up by the next sync, so
  # without this an agent asking whether it has discussed something finds its
  # own current reasoning. A conversation resumed into a second file still has
  # its earlier half under another id; --all turns the filter off entirely.
  while [ $# -gt 0 ]; do
    case "$1" in
      --sync)     shift; recall_enabled_or_die || return 1
                  printf 'ingested %s transcript(s)\n' "$(recall_sync full)"
                  sqlite3 "$RECALL_DB" "select 'turns: ' || count(*) from turn;" 2>/dev/null
                  return 0 ;;
      --sources)  local a
                  for a in $(adapters_all); do
                    if adapters_on | grep -qx "$a"; then printf '  %-8s enabled\n' "$a"
                    else printf '  %-8s disabled\n' "$a"; fi
                  done
                  return 0 ;;
      --enable)   shift; [ -n "${1:-}" ] || die "recall --enable <adapter>"
                  [ -x "$ADAPTER_DIR/$1" ] || die "no such adapter: $1 (have: $(adapters_all | tr '\n' ' '))"
                  mkdir -p "$CONF_DIR"; adapters_on | grep -qx "$1" || printf '%s\n' "$1" >> "$CONF_SOURCES"
                  echo "recall: $1 enabled"; return 0 ;;
      --disable)  shift; [ -n "${1:-}" ] || die "recall --disable <adapter>"
                  [ -f "$CONF_SOURCES" ] && { grep -vx "$1" "$CONF_SOURCES" > "$CONF_SOURCES.tmp" || true
                    mv "$CONF_SOURCES.tmp" "$CONF_SOURCES"; }
                  echo "recall: $1 disabled"; return 0 ;;
      --full)     shift; [ -n "${1:-}" ] || die "recall --full <turn-id>"
                  sqlite3 -separator '' "$RECALL_DB" "
                    select title || char(10) || ts || '  ' || role || '  ' || cwd || char(10) || char(10) || body
                    from turn where id like '${1//\'/\'\'}%' limit 1;" 2>/dev/null
                  return 0 ;;
      --limit)    shift; limit=${1:-$RECALL_LIMIT}; shift ;;
      --exclude)  shift; exclude=${1:-}; shift ;;
      --json)     json=1; shift ;;
      --all)      exclude=""; shift ;;
      --sessions) sessions=1; shift ;;
      --prefix)   prefix=1; shift ;;
      -*)         die "recall: unknown flag $1" ;;
      *)          terms+=("$1"); shift ;;
    esac
  done
  recall_enabled_or_die || return 1
  [ "${#terms[@]}" -gt 0 ] || die "usage: brain recall <terms...>"
  recall_schema
  recall_sync >/dev/null

  # snippet() and bm25() are FTS5 auxiliary functions: the docs require them in
  # a query that reads the fts table directly, and sqlite 3.53 rejects them
  # ("unable to use function bm25 in the requested context") once the call sits
  # behind an aggregate or a window. So both are computed in the CTE that does
  # the MATCH, and the join happens afterwards.
  # --prefix makes the last term a prefix match, which is what an interactive
  # caller needs: without the star an FTS5 query matches whole tokens only, so a
  # half-typed word finds nothing and the list stays empty until the word is
  # finished. The justfile asserts both halves of that ("ok exact needs the
  # whole word", "ok recall --prefix"); FTS5 spells the operator out under
  # "FTS5 Prefix Queries".
  local m t esc i=0 last=$(( ${#terms[@]} - 1 ))
  m=""
  for t in "${terms[@]}"; do
    esc=${t//\"/}
    if [ "$prefix" -eq 1 ] && [ "$i" -eq "$last" ]; then
      m="$m${m:+ AND }\"$esc\"*"
    else
      m="$m${m:+ AND }\"$esc\""
    fi
    i=$((i + 1))
  done

  local where=""
  [ -n "$exclude" ] && where="and t.session <> '${exclude//\'/\'\'}'"

  if [ "$sessions" -eq 1 ]; then
    local srows
    srows=$(sqlite3 -separator $'\t' "$RECALL_DB" "
      with hit(rid, s) as (
        select rowid, bm25(turn_fts, 1.0, 2.0)
        from turn_fts where turn_fts match '${m//\'/\'\'}'
        order by rank limit 400
      )
      select t.session, count(*), t.adapter, t.title
      from hit h join turn t on t.rowid = h.rid
      where 1=1 $where
      group by t.session
      order by min(h.s) limit $limit;" 2>/dev/null)
    # A miss exits non-zero here too, so a caller can tell one from a hit.
    [ -n "$srows" ] || return 1
    printf '%s\n' "$srows"
    return 0
  fi

  local out
  out=$(sqlite3 -separator $'\t' "$RECALL_DB" "
    with hit(rid, snip, n) as (
      select rowid, snippet(turn_fts, 0, '[', ']', ' … ', 14),
             bm25(turn_fts, 1.0, 2.0)
      from turn_fts where turn_fts match '${m//\'/\'\'}'
      order by rank limit $((limit * 4))
    )
    select substr(t.id,1,8), substr(t.ts,1,10), t.adapter, t.title, h.snip
    from hit h join turn t on t.rowid = h.rid
    where 1=1 $where
    order by h.n limit $limit;" 2>&1)

  if [ -z "$out" ]; then echo "no hits for: ${terms[*]}"; return 1; fi
  case "$out" in *"Error"*|*"error"*) printf '%s\n' "$out" >&2; return 1 ;; esac

  if [ "$json" -eq 1 ]; then
    awk -F'\t' 'BEGIN{print "["} { if (NR>1) print ",";
      gsub(/\\/,"\\\\",$5); gsub(/"/,"\\\"",$5); gsub(/"/,"\\\"",$4)
      printf "{\"id\":\"%s\",\"date\":\"%s\",\"agent\":\"%s\",\"title\":\"%s\",\"snippet\":\"%s\"}", $1,$2,$3,$4,$5 }
      END{print "]"}' <<< "$out"
  else
    awk -F'\t' '{ printf "%s  %s  %s\n    %s\n    %s\n\n", $2, $3, $4, $5, $1 }' <<< "$out"
  fi
}

# ------------------------------------------------------------- install ----
# Everything install writes to a file the user owns goes inside a tagged block,
# so it can be replaced on re-install and removed by `brain uninstall` without
# touching a line the user wrote.
DRY=0
say()  { if [ "$DRY" -eq 1 ]; then printf "  [dry] %s\n" "$*"; else printf "  %s\n" "$*"; fi; }
note() { printf "  %s\n" "$*"; }

block_begin() { printf '%s brain:%s >>> managed by `brain install`; edit the vault, not this block %s' "$1" "$2" "$3"; }
block_end()   { printf '%s brain:%s <<< %s' "$1" "$2" "$3"; }

# $1 file  $2 tag  $3 comment-open  $4 comment-close  $5 body
block_apply() {
  local file="$1" tag="$2" co="$3" cc="$4" body="$5" b e tmp
  b=$(block_begin "$co" "$tag" "$cc"); e=$(block_end "$co" "$tag" "$cc")
  [ -e "$file" ] || { [ "$DRY" -eq 1 ] || { mkdir -p "$(dirname "$file")"; : > "$file"; }; }
  if [ -f "$file" ] && grep -qF "brain:$tag >>>" "$file" 2>/dev/null; then
    local cur
    cur=$(awk -v b="brain:$tag >>>" -v e="brain:$tag <<<" 'index($0,b){f=1} f{print} index($0,e){f=0}' "$file")
    if [ "$cur" = "$(printf '%s\n%s\n%s' "$b" "$body" "$e")" ]; then say "$file: already current"; return 0; fi
    say "$file: block refreshed"
    [ "$DRY" -eq 1 ] && return 0
    cp -f "$file" "$file.brain-backup"
    tmp="$file.brain-tmp"
    awk -v b="brain:$tag >>>" -v e="brain:$tag <<<" -v new="$(printf '%s\n%s\n%s' "$b" "$body" "$e")" '
      index($0,b) { print new; skip=1; next }
      skip && index($0,e) { skip=0; next }
      skip { next }
      { print }' "$file" > "$tmp" && mv "$tmp" "$file"
  else
    say "$file: block added"
    [ "$DRY" -eq 1 ] && return 0
    [ -s "$file" ] && cp -f "$file" "$file.brain-backup"
    printf '%s\n%s\n%s\n\n%s' "$b" "$body" "$e" "$(cat "$file" 2>/dev/null)" > "$file.brain-tmp" \
      && mv "$file.brain-tmp" "$file"
  fi
}

block_remove() {
  local file="$1" tag="$2" tmp="$1.brain-tmp"
  [ -f "$file" ] || return 0
  grep -qF "brain:$tag >>>" "$file" 2>/dev/null || return 0
  say "$file: block removed"
  [ "$DRY" -eq 1 ] && return 0
  awk -v b="brain:$tag >>>" -v e="brain:$tag <<<" '
    index($0,b) { skip=1; next }
    skip && index($0,e) { skip=0; next }
    skip { next }
    { print }' "$file" > "$tmp" && mv "$tmp" "$file"
}

on_path() { case ":$PATH:" in *":$1:"*) return 0 ;; *) return 1 ;; esac; }

# The same preference order the justfile standard uses for `install`.
pick_bindir() {
  local d
  for d in "$HOME/.local/bin" "$HOME/bin" "${GOBIN:-}" "${GOPATH:+$GOPATH/bin}" "/usr/local/bin"; do
    [ -n "$d" ] || continue
    [ -d "$d" ] && [ -w "$d" ] && { printf '%s\n' "$d"; return 0; }
  done
  [ "$DRY" -eq 1 ] || mkdir -p "$HOME/.local/bin" 2>/dev/null
  printf '%s\n' "$HOME/.local/bin"
}

# Which files a login shell reads differs per platform: zsh is the macOS
# default and reads .zshenv for every invocation, Git Bash reads .bashrc.
path_rc_files() {
  case "$(os_kind)" in
    macos)   printf '%s\n' "$HOME/.zshenv" "$HOME/.bash_profile" ;;
    windows) printf '%s\n' "$HOME/.bashrc" ;;
    *)       printf '%s\n' "$HOME/.bashrc" ;;
  esac
}

# In .bashrc the block must sit above the interactive early-return, or shells
# that source the file non-interactively never reach it.
rc_block() {
  local rc="$1" body="$2" tag="$3"
  if [ -f "$rc" ] && grep -qF '[[ $- != *i* ]] && return' "$rc" 2>/dev/null \
     && ! grep -qF "brain:$tag >>>" "$rc" 2>/dev/null; then
    say "$rc: block added above the interactive guard"
    [ "$DRY" -eq 1 ] && return 0
    cp -f "$rc" "$rc.brain-backup"
    awk -v b="$(block_begin '#' "$tag" '')" -v e="$(block_end '#' "$tag" '')" -v body="$body" '
      /^\[\[ \$- != \*i\* \]\] && return/ && !done { print b; print body; print e; print ""; done=1 }
      { print }' "$rc" > "$rc.brain-tmp" && mv "$rc.brain-tmp" "$rc"
  else
    block_apply "$rc" "$tag" '#' '' "$body"
  fi
}

cmd_install() {
  local arg
  for arg in "$@"; do
    case "$arg" in
      --dry-run) DRY=1 ;;
      -*)        die "install: unknown flag $arg" ;;
      "")        ;;
      *)         [ -d "$arg" ] || die "install: no such directory: $arg"
                 VAULT=$(cd "$arg" && pwd -P) ;;
    esac
  done
  [ -n "$VAULT" ] || die "install: name the vault — brain install <path-to-vault>"
  [ -d "$VAULT/AI" ] || note "warning: $VAULT has no AI/ — is that the vault?"
  require_sqlite
  local os bindir shims
  os=$(os_kind); shims="$TOOL/bin/shims"
  bindir=$(pick_bindir)

  echo "tool:  $TOOL"
  echo "vault: $VAULT   ($os)"
  [ "$DRY" -eq 1 ] || { mkdir -p "$STATE" "$CONF_DIR"; printf '%s\n' "$VAULT" > "$CONF_VAULT"; }
  say "vault path recorded: $CONF_VAULT"
  [ "$DRY" -eq 1 ] || chmod +x "$TOOL/bin/brain" "$TOOL/bin/hooks/"* "$TOOL/bin/shims/"* 2>/dev/null

  echo "cli:"
  if [ "$DRY" -eq 1 ]; then
    say "cli link: $bindir/brain"
  elif [ "$os" = windows ]; then
    # MSYS `ln -s` silently copies unless Developer Mode is on, and a copy puts
    # TOOL at $HOME: no adapters, no synonyms, and stale after every pull. A
    # wrapper runs the checkout itself, and brain.cmd is what PowerShell and cmd
    # resolve — through this bash by full path, never PATH's system32\bash.exe,
    # which is WSL.
    printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$TOOL/bin/brain" > "$bindir/brain" && chmod +x "$bindir/brain"
    printf '@echo off\r\nsetlocal\r\nset BRAIN_NATIVE=1\r\n"%s" "%s" %%*\r\nexit /b %%ERRORLEVEL%%\r\n' \
      "$(cygpath -w "$BASH")" "$(cygpath -m "$TOOL/bin/brain")" > "$bindir/brain.cmd"
    say "cli wrappers: $bindir/brain, $bindir/brain.cmd -> $TOOL/bin/brain"
  elif ln -sf "$TOOL/bin/brain" "$bindir/brain" 2>/dev/null; then
    say "cli link: $bindir/brain"
  else
    cp -f "$TOOL/bin/brain" "$bindir/brain" && chmod +x "$bindir/brain"
    say "copied $bindir/brain (no symlink support; re-run install after an update)"
  fi
  if on_path "$bindir"; then
    note "$bindir is already on PATH"
  else
    path_rc_files | while IFS= read -r rc; do rc_block "$rc" "export PATH=\"$bindir:\$PATH\"" "path"; done
    note "open a new shell, or: export PATH=\"$bindir:\$PATH\""
    [ "$os" = windows ] && note "for PowerShell and cmd, add $(cygpath -w "$bindir") to the user PATH"
  fi

  echo "git hooks:"
  # The hooks ship with the tool, so this path leaves the vault: it has to be
  # absolute, and re-running install is what fixes it after either repository
  # moves.
  [ "$DRY" -eq 1 ] || git -C "$VAULT" config core.hooksPath "$TOOL/bin/hooks"
  say "core.hooksPath = $TOOL/bin/hooks"

  echo "guards:"
  # The old shell-function guard, superseded by the shims.
  if grep -qF 'brain-guards.sh' "$HOME/.bashrc" 2>/dev/null; then
    say "$HOME/.bashrc: removing the superseded shell-function guard"
    [ "$DRY" -eq 1 ] || { grep -v 'brain-guards.sh' "$HOME/.bashrc" \
      | grep -v '^# Brain guards: refuse' > "$HOME/.bashrc.brain-tmp" && mv "$HOME/.bashrc.brain-tmp" "$HOME/.bashrc"; }
  fi
  path_rc_files | while IFS= read -r rc; do rc_block "$rc" "export PATH=\"$shims:\$PATH\"" "guards"; done
  if [ "$os" = linux ]; then
    local envd="$HOME/.config/environment.d/10-brain-shims.conf"
    say "$envd — covers every shell in the session, from the next login"
    [ "$DRY" -eq 1 ] || { mkdir -p "$HOME/.config/environment.d"
      printf '# Brain guards: refuse commands recorded as traps.\nPATH=%s:${PATH}\n' "$shims" > "$envd"; }
  else
    note "on $os only shells reading the files above are covered"
  fi

  echo "agent bindings:"
  # ~/.agents/AGENTS.md is the canonical binding: pi and Codex already symlink
  # to it, so pointing it at this clone is all a new machine needs.
  local agents="$HOME/.agents/AGENTS.md"
  if [ "$DRY" -eq 1 ]; then
    say "agents link: $agents -> $VAULT/AI/AGENTS.md"
  else
    mkdir -p "$HOME/.agents"
    # nativestrict makes MSYS fail rather than copy when Windows refuses a
    # symlink (no Developer Mode); a copy is then made on purpose, and said so.
    if MSYS=winsymlinks:nativestrict ln -sfn "$VAULT/AI/AGENTS.md" "$agents" 2>/dev/null && [ -L "$agents" ]; then
      say "agents link: $agents -> $VAULT/AI/AGENTS.md"
    elif cp -f "$VAULT/AI/AGENTS.md" "$agents" 2>/dev/null; then
      say "copied $agents (no symlink support; re-run install after editing AGENTS.md)"
    else
      say "could not link $agents (copy it by hand)"
    fi
  fi
  # Tilde imports are supported, so this block is identical on every machine.
  block_apply "$HOME/.claude/CLAUDE.md" "claude" '<!--' '-->' \
"@~/.agents/AGENTS.md

The Brain is this machine's shared agent memory. \`brain locate\` prints its path,
\`brain find <handle>\` searches it, and \`brain recall <terms>\` searches what was
said in past agent conversations. Do not hard-code the path."
  # An absolute import of the same file would load it a second time.
  if grep -q "^@.*${VAULT}/AI/AGENTS.md" "$HOME/.claude/CLAUDE.md" 2>/dev/null; then
    say "$HOME/.claude/CLAUDE.md: dropping the now-duplicate absolute import"
    [ "$DRY" -eq 1 ] || { grep -v "^@.*${VAULT}/AI/AGENTS.md" "$HOME/.claude/CLAUDE.md" \
      > "$HOME/.claude/CLAUDE.md.brain-tmp" && mv "$HOME/.claude/CLAUDE.md.brain-tmp" "$HOME/.claude/CLAUDE.md"; }
  fi
  # pi and Codex are pointer-only by design; verify rather than edit them.
  local a
  for a in "$HOME/.pi/agent/AGENTS.md" "$HOME/.codex/AGENTS.md"; do
    if [ -e "$a" ]; then
      # readlink -f is GNU-only; readable is all this needs to know.
      if [ -r "$a" ]; then note "$a resolves (pointer-only by design; left alone)"
      else note "$a exists but is not readable"; fi
    else
      note "$a absent — link it to $agents if that agent is used here"
    fi
  done

  echo "scanner:"
  if find_gitleaks >/dev/null 2>&1; then note "gitleaks: $(find_gitleaks)"
  else note "gitleaks missing — pacman -S gitleaks / brew install gitleaks / scoop install gitleaks"; fi

  [ "$DRY" -eq 1 ] && { echo; echo "(dry run: nothing was written)"; return 0; }
  cmd_sync
}

cmd_uninstall() {
  [ "${1:-}" = "--dry-run" ] && DRY=1
  echo "removing this machine's bindings; the vault itself is untouched"
  local rc f
  path_rc_files | while IFS= read -r rc; do
    block_remove "$rc" "path"; block_remove "$rc" "guards"
  done
  block_remove "$HOME/.claude/CLAUDE.md" "claude"
  for f in "$HOME/.config/environment.d/10-brain-shims.conf" "$CONF_VAULT" "$(pick_bindir)/brain" "$(pick_bindir)/brain.cmd"; do
    [ -e "$f" ] || continue
    say "remove $f"
    [ "$DRY" -eq 1 ] || rm -f "$f"
  done
  note "left alone: ~/.agents/AGENTS.md, the index in $STATE, and the vault"
  [ "$DRY" -eq 1 ] && echo "(dry run: nothing was written)"
}

usage() {
  cat <<'USAGE'
brain — query and lint the vault. Markdown is canonical; the index is disposable.

  brain locate [--native] absolute path to the vault, for agents and scripts
  brain locate --tool     absolute path to this CLI's own checkout
  brain find <terms...>   search bullets, handle matches ranked first
  brain recall <terms...> search agent transcripts: what was said, not what is true
    --sync --sources --enable <a> --disable <a> --full <id> --limit N --json
    --sessions (one row per conversation)  --prefix (last term matches as a prefix)
  brain sync              rebuild the index from markdown
  brain doctor            what is stale, thin, oversized, duplicated or orphaned
  brain log               misses that still miss, and who is asking
  brain lint [--staged]   check bullet form; hard failures block a commit
  brain secrets [--staged|--history]  scan for credentials (gitleaks, with a fallback)
  brain install [<vault>] [--dry-run]  bind this machine to a vault
  brain uninstall [--dry-run]  undo those bindings; the vault is untouched

This CLI and the notes it searches are separate repositories. The vault is
named once, by 'brain install <path>', and recorded in ~/.config/brain/vault.

Zero-hit queries are recorded so the synonym table fills from real misses
rather than guesswork; edit bin/synonyms.tsv and run 'brain sync'.
USAGE
}

case "${1:-}" in
  find)    shift; cmd_find "$@" ;;
  recall)  shift; cmd_recall "$@" ;;
  locate)  shift; cmd_locate "${1:-}" ;;
  sync)    shift; cmd_sync ;;
  doctor)  shift; cmd_doctor ;;
  log)     shift; cmd_log ;;
  lint)    shift; cmd_lint "$@" ;;
  secrets) shift; cmd_secrets "${1:---staged}" ;;
  install)   shift; cmd_install "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command: $1 (try 'brain help')" ;;
esac
