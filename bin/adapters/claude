#!/usr/bin/env bash
# Claude Code transcripts — ~/.claude/projects/<cwd-slug>/<session-id>.jsonl
#
#   claude --list          every transcript on this machine, one path per line
#   claude --emit <path>   that transcript's turns, as TSV
#
# TSV columns: id, timestamp, role, session, title, cwd, body.
#
# A transcript with no title record is a headless API run — the `review` CLI
# and friends — not a conversation, and produces nothing. That is most of the
# corpus: on 2026-09-25 this machine had 2314 transcripts and 233 titled
# conversations among them (`--list | wc -l` against the picker's index).
set -uo pipefail

ROOT="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
# A native jq.exe writes CRLF, so every jq read below ends in tr -d '\r'.

emit() {
  local f=$1 sid title cwd
  [ -f "$f" ] || return 0
  sid=${f##*/}; sid=${sid%.jsonl}

  # grep first: reading the title out of a 9 MB transcript with jq alone costs
  # far more than filtering the two lines that can carry one.
  title=$(grep -h '"type":"custom-title"' "$f" 2>/dev/null | tail -1 \
          | jq -r '.customTitle // empty' 2>/dev/null | tr -d '\r' || true)
  [ -n "$title" ] || title=$(grep -h '"type":"ai-title"' "$f" 2>/dev/null | tail -1 \
          | jq -r '.aiTitle // empty' 2>/dev/null | tr -d '\r' || true)
  [ -n "$title" ] || return 0

  # Through jq, not cut: a Windows cwd is JSON-escaped as C:\\Users\\...
  cwd=$(grep -m1 -h '"cwd":"' "$f" 2>/dev/null | jq -r '.cwd // empty' 2>/dev/null | tr -d '\r' || true)

  jq -r --arg sid "$sid" --arg title "$title" --arg cwd "${cwd:-}" '
    select((.type == "user" or .type == "assistant")
           and .isSidechain != true
           and (.isMeta // false) == false
           and (.userType // "external") == "external")
    | (.message.content
       | if type == "string" then .
         else ([.[]? | select(.type == "text") | .text] | join("\n")) end) as $b
    | select($b != null and ($b | length) > 0)
    | select(($b | startswith("<command-name>") or startswith("<local-command-stdout>")
              or startswith("<command-message>") or startswith("<system-reminder>")
              or startswith("<function_results>") or startswith("Caveat:")) | not)
    | select(.uuid != null)
    | [.uuid, (.timestamp // ""), .type, $sid, $title, $cwd,
       ($b | gsub("[[:space:]]+"; " "))]
    # Not @tsv: it writes a backslash as \\ and nothing downstream undoes it,
    # so every Windows cwd was stored as C:\\Users\\... A row only needs its
    # tabs and newlines gone.
    | map(tostring | gsub("[\t\n\r]"; " ")) | join("\t")
  ' "$f" 2>/dev/null | tr -d '\r' || true
}

case "${1:-}" in
  --list) [ -d "$ROOT" ] && find "$ROOT" -name '*.jsonl' -type f 2>/dev/null; exit 0 ;;
  --emit) emit "${2:?usage: claude --emit <path>}" ;;
  *)      echo "usage: claude --list | --emit <path>" >&2; exit 2 ;;
esac
