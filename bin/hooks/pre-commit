#!/usr/bin/env bash
# Brain pre-commit: the vault's invariants, enforced rather than recalled.
# Hard failures block; warnings are printed and ignored.
set -uo pipefail
root=$(git rev-parse --show-toplevel)

# The CLI ships with the hooks, not with the repository being committed, so it
# is resolved as this hook's own sibling: a build in the checkout first, then
# whatever `brain` is on PATH. `$root/bin/brain` only ever worked because the
# tool happened to live in the vault; once it moved out that path found
# nothing and this gate became a silent pass (observed 2026-09-25, when an
# undated bullet was committed clean). The test suite asserts the gate fires
# from a repository that does not contain the CLI.
hookdir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
brain=""
for c in "$hookdir/../../build/release/brain" "$hookdir/../../build/debug/brain" \
         "$(command -v brain 2>/dev/null)" "$hookdir/../brain"; do
  [ -n "$c" ] && [ -x "$c" ] && { brain=$c; break; }
done
if [ -z "$brain" ]; then
  # Still non-blocking, but never again silent: a gate that cannot run should
  # say so rather than look like a pass.
  echo "pre-commit: brain CLI not found — lint and secret gates DID NOT RUN" >&2
  exit 0
fi

fail=0
BRAIN_VAULT="$root" "$brain" lint --staged || fail=1
BRAIN_VAULT="$root" "$brain" secrets --staged || fail=1

if [ "$fail" -ne 0 ]; then
  echo
  echo "Commit refused. Fix the failures above, record a deliberate exception"
  echo "(gitleaks:allow, or the allowlist in .gitleaks.toml), and try again."
  echo "--no-verify only if the rule itself is wrong — then fix the rule."
  exit 1
fi
