#!/usr/bin/env bash
# Rebuild the index after every commit: exact, and simpler than a timer.
# Never fails a commit — the index is disposable.
set -uo pipefail
root=$(git rev-parse --show-toplevel)
hookdir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
for c in "$hookdir/../../build/release/brain" "$hookdir/../../build/debug/brain" \
         "$(command -v brain 2>/dev/null)" "$hookdir/../brain"; do
  [ -n "$c" ] && [ -x "$c" ] && { BRAIN_VAULT="$root" "$c" sync >/dev/null 2>&1; break; }
done
exit 0
